{
  "name": "@ossuary/skeleton",
  "version": "0.0.0",
  "private": true,
  "description": "The Ossuary skeleton. Apps import only from this entry point.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "smoke": "vitest run -c vitest.smoke.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@electric-sql/pglite": "0.6.0",
    "drizzle-orm": "0.45.4",
    "openai": "7.64.0",
    "pg": "8.23.1",
    "yaml": "catalog:",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
