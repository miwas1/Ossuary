# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Local database: PostgreSQL installed in WSL (see docs/decisions.md, "Local PostgreSQL in WSL").
# Tests and pnpm verify don't use this; they run on in-memory PGlite.
DATABASE_URL=postgres://ossuary:<password>@localhost:5432/ossuary

# Only for docker-compose.yml on a machine that has Docker. There is no default password (D-30).
POSTGRES_USER=ossuary
POSTGRES_PASSWORD=
POSTGRES_DB=ossuary
POSTGRES_PORT=5432

# Model vendors (Phase 1)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Voice (Phase 0 spike, Phase 5)
VOICE_LLM_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Blob storage (Phase 4)
BLOB_ENDPOINT=
BLOB_BUCKET=
BLOB_KEY=
BLOB_SECRET=

# MCP and demo mode
OSSUARY_MCP_KEY=
DEMO_MODE=true
DAILY_SPEND_CAP_USD=
